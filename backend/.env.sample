# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://admin:admin123@localhost:27017/washmind?authSource=admin
MONGO_DB=washmind

# ── Authentication (JWT) ─────────────────────────────────────
JWT_SECRET_KEY=washmind-dev-secret-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Super Admin (seeded on startup) ──────────────────────────
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=WashMind@2026!

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ──────────────────────────────────────────────────────
APP_NAME=WashMind
APP_VERSION=0.1.0
DEBUG=true
